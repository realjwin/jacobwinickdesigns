---
import { getCollection } from 'astro:content';
import Sheet from '../layouts/Sheet.astro';
import Constellation from '../components/Constellation.astro';
import Register from '../components/Register.astro';
import { arc, revisions } from '../data/resume';

const featured = (await getCollection('work', (e) => e.data.featured)).sort((a, b) => a.data.order - b.data.order);
---
<Sheet title="General arrangement" dwg="A-001" sheet="1 OF 4">
  <section class="region hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="label"><span class="red">Sheet A-001</span> · General arrangement</p>
      <h1 id="hero-title">Jacob<br />Winick</h1>
      <p class="lede">
        I build satellite modems. As one of the first hundred employees at{' '}
        <strong>Amazon Leo</strong>, I carried its custom modem silicon from a MATLAB
        simulation through seven chip iterations to production firmware running on satellites.
        Now I lead a firmware team and build AI-first, agentic test infrastructure for it.
      </p>
      <ol class="callouts" aria-label="Key notes">
        <li><span class="balloon" aria-hidden="true">1</span><span><b>Engineering manager</b>, modem systems embedded firmware, Amazon Leo</span></li>
        <li><span class="balloon" aria-hidden="true">2</span><span><b>M.S. EE, UT Austin</b>, research in machine learning for wireless</span></li>
        <li><span class="balloon" aria-hidden="true">3</span><span><b>Next:</b> bringing frontier AI from prototype to product at scale</span></li>
      </ol>
      <div class="cta">
        <a class="btn primary" href="/work" data-dim>Drawing register <span aria-hidden="true">→</span></a>
        <a class="btn" href="/resume" data-dim>Résumé</a>
      </div>
    </div>
    <div class="hero-fig">
      <Constellation snr={15} />
      <p class="label fig-note">Drag E<sub>s</sub>/N<sub>0</sub>. Red points are decoded wrong.</p>
    </div>
  </section>

  <section class="region" aria-labelledby="arc-title">
    <div class="section-head">
      <h2 id="arc-title">Section A–A: Simulation to orbit</h2>
      <span class="label">Amazon Leo · Mar 2020 – present</span>
    </div>
    <ol class="arc">
      {arc.map((a, i) => (
        <li data-dim>
          <span class="arc-stage mono red">{String(i + 1).padStart(2, '0')} · {a.stage}</span>
          <span class="arc-label">{a.label}</span>
          <span class="arc-note label">{a.note}</span>
        </li>
      ))}
    </ol>
    <p class="arc-foot label">Seven silicon iterations · team grown 3 → 7 in one quarter · first prototype satellites launched on Atlas V</p>
  </section>

  <section class="region" aria-labelledby="reg-title">
    <div class="section-head">
      <h2 id="reg-title">Selected drawings</h2>
      <a class="label" href="/work" data-dim>Full register →</a>
    </div>
    <p class="intro">Research from graduate school and things I build outside work. The day job is in the <a href="/resume">résumé</a>.</p>
    <Register entries={featured} caption="Selected projects" />
  </section>

  <section class="region notes-rev">
    <div>
      <h2 class="label">General notes</h2>
      <ol class="gnotes">
        <li>Detail work is in Python, C/C++ and MATLAB unless noted.</li>
        <li>This sheet is the current revision and supersedes jacobwinick.com (2019).</li>
        <li>Off the clock: backcountry skiing, bikepacking, sailing, film photography, violin and saxophone. A camper van is under construction. See <a href="/about">About</a>.</li>
      </ol>
    </div>
    <table class="revtable">
      <caption>Revisions</caption>
      <thead><tr><th>Rev</th><th>Date</th><th>Description</th></tr></thead>
      <tbody>{revisions.map((r) => <tr><td>{r.rev}</td><td>{r.date}</td><td>{r.desc}</td></tr>)}</tbody>
    </table>
  </section>
</Sheet>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: start; }
  .hero h1 { font-size: clamp(3.4rem, 10vw, 8.2rem); font-weight: 500; letter-spacing: -0.045em; line-height: 0.88; margin: 18px 0 24px; }
  .lede { font-size: clamp(1.08rem, 1.5vw, 1.26rem); line-height: 1.55; max-width: 36em; }
  .lede strong { font-weight: 600; }
  .callouts { list-style: none; padding: 0; margin: 24px 0 28px; display: grid; gap: 10px; }
  .callouts li { display: flex; gap: 12px; align-items: baseline; font-size: 0.98rem; }
  .callouts b { font-weight: 600; }
  .balloon { flex: none; width: 22px; height: 22px; border: 1px solid var(--red); border-radius: 50%; display: inline-grid; place-items: center; font-family: var(--f-mono); font-size: 0.7rem; color: var(--red); transform: translateY(-1px); }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 16px; border: 1px solid var(--ink); text-decoration: none; font-family: var(--f-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .btn.primary { background: var(--ink); color: var(--paper); }
  .btn.primary:hover { background: var(--red); border-color: var(--red); color: var(--paper); }
  .fig-note { margin-top: 8px; }

  .arc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .arc li { position: relative; border: 0.75px solid var(--ink); padding: 14px 14px 16px; display: flex; flex-direction: column; gap: 6px; background: var(--paper); }
  .arc li + li { border-left: 0; }
  .arc li:not(:last-child)::after {
    content: ''; position: absolute; right: -6px; top: 50%; width: 10px; height: 10px; z-index: 1;
    border-top: 1px solid var(--red); border-right: 1px solid var(--red); background: var(--paper);
    transform: translateY(-50%) rotate(45deg);
  }
  .arc-label { font-family: var(--f-head); font-size: 1.05rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.2; }
  .arc-stage { font-size: 0.7rem; }
  .arc-foot { margin: 14px 0 0; }

  .intro { color: var(--ink-2); max-width: 60ch; margin-top: -8px; }

  .notes-rev { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .gnotes { margin: 10px 0 0; padding-left: 1.4em; font-size: 0.95rem; color: var(--ink-2); display: grid; gap: 6px; }
  .gnotes li::marker { font-family: var(--f-mono); color: var(--ink-3); font-size: 0.8em; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-fig { max-width: 460px; }
    .arc { grid-template-columns: 1fr; }
    .arc li + li { border-left: 0.75px solid var(--ink); border-top: 0; }
    .arc li:not(:last-child)::after { right: auto; left: 24px; top: auto; bottom: -6px; transform: rotate(135deg); }
    .notes-rev { grid-template-columns: 1fr; }
  }
</style>
