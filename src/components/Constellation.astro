---
import { draws, received, serTheory, fmtSci, N } from '../scripts/qam';

interface Props { snr?: number }
const { snr = 12 } = Astro.props;
const S = 320, PAD = 22, LIM = 4.6;
const sc = (v: number) => PAD + ((v + LIM) / (2 * LIM)) * (S - 2 * PAD);
const { pts, errors } = received(draws(), snr);
const ideal = [-3, -1, 1, 3].flatMap((i) => [-3, -1, 1, 3].map((q) => [i, q]));
---
<figure class="qam" data-snr={snr}>
  <div class="qam-head">
    <span class="label red">Fig. 0</span>
    <span class="label">Detail — 16-QAM, AWGN channel · simulated live</span>
  </div>
  <svg viewBox={`0 0 ${S} ${S}`} role="img" aria-label="Scatter plot of 512 received 16-QAM symbols. As SNR rises the points tighten around the 16 ideal constellation points." data-dim>
    <rect x="0.5" y="0.5" width={S - 1} height={S - 1} class="bx" />
    {[-2, 0, 2].map((v) => (
      <>
        <line x1={sc(v)} x2={sc(v)} y1={PAD - 8} y2={S - PAD + 8} class={v === 0 ? 'axis' : 'bound'} />
        <line y1={sc(v)} y2={sc(v)} x1={PAD - 8} x2={S - PAD + 8} class={v === 0 ? 'axis' : 'bound'} />
      </>
    ))}
    <text x={S - PAD + 4} y={sc(0) - 6} class="ax" text-anchor="end">I</text>
    <text x={sc(0) + 6} y={PAD + 2} class="ax">Q</text>
    <g class="rx">
      {pts.map((p) => <circle cx={sc(p.i).toFixed(1)} cy={sc(-p.q).toFixed(1)} r="1.6" class={p.err ? 'e' : undefined} />)}
    </g>
    {ideal.map(([i, q]) => (
      <path d={`M${sc(i) - 4},${sc(q)}h8M${sc(i)},${sc(q) - 4}v8`} class="ideal" />
    ))}
  </svg>
  <div class="qam-ctl">
    <label for="snr" class="label">E<sub>s</sub>/N<sub>0</sub></label>
    <input id="snr" type="range" min="0" max="30" step="0.5" value={snr} aria-valuetext={`${snr.toFixed(1)} dB`} data-dim />
    <output for="snr" class="mono" id="snr-out">{snr.toFixed(1)} dB</output>
  </div>
  <dl class="qam-stats mono">
    <div><dt>Symbol errors</dt><dd id="ser-n">{errors} / {N}</dd></div>
    <div><dt>SER, theory</dt><dd id="ser-t">{fmtSci(serTheory(snr))}</dd></div>
  </dl>
</figure>

<script>
  import { draws, received, serTheory, fmtSci, N } from '../scripts/qam';
  const fig = document.querySelector<HTMLElement>('figure.qam');
  if (fig) {
    const S = 320, PAD = 22, LIM = 4.6;
    const sc = (v: number) => PAD + ((v + LIM) / (2 * LIM)) * (S - 2 * PAD);
    const d = draws();
    const dots = Array.from(fig.querySelectorAll<SVGCircleElement>('.rx circle'));
    const input = fig.querySelector<HTMLInputElement>('#snr')!;
    const out = fig.querySelector('#snr-out')!;
    const n = fig.querySelector('#ser-n')!;
    const t = fig.querySelector('#ser-t')!;
    let raf = 0;
    const render = () => {
      const snr = Number(input.value);
      const { pts, errors } = received(d, snr);
      pts.forEach((p, k) => {
        const c = dots[k];
        c.setAttribute('cx', sc(p.i).toFixed(1));
        c.setAttribute('cy', sc(-p.q).toFixed(1));
        c.classList.toggle('e', p.err);
      });
      out.textContent = `${snr.toFixed(1)} dB`;
      input.setAttribute('aria-valuetext', `${snr.toFixed(1)} dB, ${errors} of ${N} symbols in error`);
      n.textContent = `${errors} / ${N}`;
      t.textContent = fmtSci(serTheory(snr));
    };
    input.addEventListener('input', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(render); });
  }
</script>

<style>
  .qam { margin: 0; border: 0.75px solid var(--ink); background: var(--paper); display: flex; flex-direction: column; }
  .qam-head { display: flex; gap: 10px; padding: 8px 12px; border-bottom: 0.75px solid var(--ink); flex-wrap: wrap; }
  .qam svg { width: 100%; height: auto; }
  .bx { fill: none; stroke: none; }
  .axis { stroke: var(--ink-2); stroke-width: 0.75; }
  .bound { stroke: var(--hair); stroke-width: 0.75; stroke-dasharray: 3 3; }
  .ax { font-family: var(--f-mono); font-size: 10px; fill: var(--ink-2); }
  .rx circle { fill: var(--ink); opacity: 0.55; }
  .rx circle.e { fill: var(--red); opacity: 0.95; }
  .ideal { stroke: var(--blue); stroke-width: 1.25; }
  .qam-ctl { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 10px 12px; border-top: 0.75px solid var(--ink); }
  .qam-ctl output { min-width: 6ch; text-align: right; font-size: 0.78rem; }
  .qam-stats { display: grid; grid-template-columns: 1fr 1fr; margin: 0; border-top: 0.75px solid var(--ink); }
  .qam-stats div { padding: 6px 12px 8px; }
  .qam-stats div + div { border-left: 0.75px solid var(--ink); }
  .qam-stats dt { font-size: var(--k-size); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .qam-stats dd { margin: 0; font-size: 0.8rem; }

  input[type='range'] { -webkit-appearance: none; appearance: none; width: 100%; height: 24px; background: transparent; cursor: ew-resize; }
  input[type='range']::-webkit-slider-runnable-track { height: 1px; background: var(--ink); }
  input[type='range']::-moz-range-track { height: 1px; background: var(--ink); }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 18px; margin-top: -9px; background: var(--paper); border: 1.25px solid var(--red); border-radius: 0; }
  input[type='range']::-moz-range-thumb { width: 10px; height: 16px; background: var(--paper); border: 1.25px solid var(--red); border-radius: 0; }
</style>
